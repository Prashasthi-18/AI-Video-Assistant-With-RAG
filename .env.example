# Copy this file to .env and fill in your keys.

# Required — LLM for titles, summaries, insights and chat (free key: https://console.mistral.ai)
MISTRAL_API_KEY=

# Recommended — fast cloud transcription for English audio (free key: https://console.groq.com)
GROQ_API_KEY=

# Optional — Hindi / Hinglish transcription (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Optional tuning
WHISPER_MODEL=small
# MISTRAL_MODEL=ministral-14b-latest
